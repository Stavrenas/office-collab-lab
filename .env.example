# Loopback-bound evaluation lab — do not publish these ports.
HARNESS_PORT=3100
HARNESS_PUBLIC_URL=http://host.docker.internal:3100
HARNESS_BROWSER_URL=http://localhost:3100

LAB_USERS=alice:Alice Evaluator,bob:Bob Evaluator,carol:Carol Evaluator
LAB_SESSION_SECRET=change-me-session-secret

EO_JWT_SECRET=change-me-eurooffice-jwt-secret-32bytes-min
EO_PUBLIC_URL=http://localhost:8082
EO_INTERNAL_URL=http://eurooffice

COLLABORA_PUBLIC_URL=http://localhost:9980
COLLABORA_INTERNAL_URL=http://collabora:9980
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=change-me
# compose mode: http://harness:3100 — host-run harness: http://host.docker.internal:3100
COLLABORA_ALIASGROUP=http://host.docker.internal:3100
